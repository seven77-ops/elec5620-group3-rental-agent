{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Self-contained local contract; format validation must be enabled. Business cross-field rules remain in Python.",
  "title": "SelectedListingEvidence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_mode": {
      "const": "synthetic_demo"
    },
    "recipient": {
      "const": "ContractAgent"
    },
    "handoff_status": {
      "const": "prepared_not_sent"
    },
    "recommendation_run_id": {
      "type": "string",
      "pattern": "^rr-[0-9a-f]{64}$"
    },
    "selection_check_run_id": {
      "type": "string",
      "pattern": "^rr-[0-9a-f]{64}$"
    },
    "dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "search_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "listing_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    },
    "user_confirmed": {
      "const": true
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "search_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "type": "object",
          "properties": {
            "currency": {
              "const": "AUD"
            },
            "period": {
              "const": "week"
            },
            "scope": {
              "enum": [
                "per_person",
                "per_room",
                "whole_property"
              ]
            },
            "includes_bills": {
              "type": "boolean"
            },
            "preferred": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "maximum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "hard_limit": {
              "type": "boolean"
            }
          },
          "required": [
            "currency",
            "period",
            "scope",
            "includes_bills",
            "preferred",
            "maximum",
            "hard_limit"
          ],
          "additionalProperties": false
        },
        "occupants": {
          "type": "integer",
          "minimum": 1
        },
        "rental_mode": {
          "enum": [
            "whole_property",
            "private_room",
            "shared_room",
            "student_accommodation"
          ]
        },
        "destination_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "arrival_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "const": "Australia/Sydney"
        },
        "commute": {
          "type": "object",
          "properties": {
            "modes": {
              "type": "array",
              "items": {
                "enum": [
                  "public_transport",
                  "walk",
                  "drive",
                  "bike"
                ]
              },
              "minItems": 1
            },
            "preferred_minutes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "maximum_minutes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "hard_limit": {
              "type": "boolean"
            }
          },
          "required": [
            "modes",
            "preferred_minutes",
            "maximum_minutes",
            "hard_limit"
          ],
          "additionalProperties": false
        },
        "move_in_window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "lease_months": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "hard_requirements": {
          "type": "array",
          "items": {
            "enum": [
              "private_bedroom",
              "private_bathroom",
              "furnished",
              "laundry",
              "kitchen_access"
            ]
          }
        },
        "soft_preferences": {
          "type": "object",
          "properties": {
            "private_bedroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "private_bathroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "furnished": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "laundry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "kitchen_access": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "commute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "housing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "amenities": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "search_id",
        "profile_version",
        "budget",
        "occupants",
        "rental_mode",
        "destination_id",
        "arrival_time",
        "timezone",
        "commute",
        "move_in_window",
        "lease_months",
        "hard_requirements",
        "soft_preferences",
        "weights"
      ],
      "additionalProperties": false
    },
    "listing_snapshot": {
      "type": "object",
      "properties": {
        "listing_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_listing_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "data_kind": {
          "const": "synthetic"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "listing_id",
        "source",
        "source_listing_id",
        "data_kind"
      ],
      "additionalProperties": true
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "listing_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_listing_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "data_kind": {
            "const": "synthetic"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "required": [
          "listing_id",
          "source",
          "source_listing_id",
          "data_kind"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "assessment": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluation"
        },
        {
          "properties": {
            "status": {
              "const": "eligible"
            }
          }
        }
      ]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "data_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema_version",
    "data_mode",
    "recipient",
    "handoff_status",
    "recommendation_run_id",
    "selection_check_run_id",
    "dataset_fingerprint",
    "profile_fingerprint",
    "search_id",
    "profile_version",
    "listing_id",
    "selected_at",
    "user_confirmed",
    "profile",
    "listing_snapshot",
    "source_records",
    "assessment",
    "unresolved_items",
    "data_limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "data_kind": {
          "const": "synthetic"
        }
      },
      "required": [
        "source_ref",
        "observed_at",
        "data_kind"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "listing_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "eligible",
            "pending",
            "excluded"
          ]
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "score_range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "score_breakdown": {
          "type": "object",
          "properties": {
            "commute": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "cost": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "housing": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "amenities": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        },
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hard_checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "weekly_cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "commute_minutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "walking_minutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "transfers": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "supermarket_distance_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "evidence_refs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence"
          }
        },
        "last_checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "listing_id",
        "status",
        "rank",
        "score",
        "score_range",
        "score_breakdown",
        "evidence_coverage",
        "hard_checks",
        "weekly_cost",
        "commute_minutes",
        "walking_minutes",
        "transfers",
        "supermarket_distance_m",
        "reasons",
        "tradeoffs",
        "issues",
        "evidence_refs",
        "last_checked_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "eligible"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "score_range": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "rank": {
                "type": "null"
              },
              "score_range": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "excluded"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              },
              "rank": {
                "type": "null"
              },
              "score_range": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
