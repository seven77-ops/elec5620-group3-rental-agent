# Backend-only AI configuration. Copy to .env locally; never commit the filled file.
# scripts/dev.py reads these allowlisted settings. Restart after changing them.
RENTAL_AI_ENABLED=0
# Full HTTPS OpenAI-compatible Chat Completions URL, not a base URL.
RENTAL_AI_URL=https://your-provider.example/v1/chat/completions
RENTAL_AI_MODEL=
RENTAL_AI_API_KEY=
RENTAL_AI_TIMEOUT_SECONDS=12
RENTAL_AI_ASSISTANT_TEMPERATURE=0.6
# Generic RENTAL_AI_* settings take precedence over AGENT3_MODEL_* aliases.
# Actual model success requires a real configured provider; no product mock mode.

# Real-data queries: server only. Restart scripts/dev.py after changing settings.
TFNSW_API_KEY=
# Optional local MCP service. Install once with scripts/setup_tfnsw_mcp.py.
# scripts/dev.py starts it on loopback; the backend supplies TFNSW_API_KEY in headers.
RENTAL_TFNSW_MCP_ENABLED=1
RENTAL_TFNSW_MCP_PORT=6401
# For manually managed loopback MCP only (not needed with scripts/dev.py):
# RENTAL_TFNSW_MCP_URL=http://127.0.0.1:6401/mcp
DOMAIN_API_KEY=
# Set only after Domain confirms this application's intended data use.
DOMAIN_USE_APPROVED=0
