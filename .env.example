# Backend-only AI configuration. Copy to .env locally; never commit the filled file.
# scripts/dev.py reads these allowlisted settings. Restart after changing them.
RENTAL_AI_ENABLED=0
# Full HTTPS OpenAI-compatible Chat Completions URL, not a base URL.
RENTAL_AI_URL=https://your-provider.example/v1/chat/completions
RENTAL_AI_MODEL=
RENTAL_AI_API_KEY=
RENTAL_AI_TIMEOUT_SECONDS=12
# Contract field extraction has a separate total deadline (1-60 seconds).
RENTAL_AI_LEASE_TIMEOUT_SECONDS=45
RENTAL_AI_ASSISTANT_TEMPERATURE=0.6

# Optional Jev classification through OpenRouter. Separate from the Alibaba key.
# off: original flow; shadow: nonblocking observation; active: validated routing.
OPENROUTER_API_KEY=
RENTAL_JEV_MODE=off
RENTAL_JEV_MODEL=typesafe/jev-1.14
RENTAL_JEV_TIMEOUT_SECONDS=3
# Initial policy values, not measured correctness probabilities. Evaluate before enabling.
RENTAL_JEV_MIN_CONFIDENCE=0.65
RENTAL_JEV_MIN_MARGIN=0.15
# Generic RENTAL_AI_* settings take precedence over AGENT3_MODEL_* aliases.
# Actual model success requires a real configured provider; no product mock mode.

# Real-data queries: server only. Restart scripts/dev.py after changing settings.
TFNSW_API_KEY=
# Optional local MCP service. Install once with scripts/setup_tfnsw_mcp.py.
# scripts/dev.py starts it on loopback; the backend supplies TFNSW_API_KEY in headers.
RENTAL_TFNSW_MCP_ENABLED=1
RENTAL_TFNSW_MCP_PORT=6401
# For manually managed loopback MCP only (not needed with scripts/dev.py):
# RENTAL_TFNSW_MCP_URL=http://127.0.0.1:6401/mcp
DOMAIN_API_KEY=
# Set only after Domain confirms this application's intended data use.
DOMAIN_USE_APPROVED=0

# English public-knowledge RAG. The user confirmed the same key as chat.
# Leave RENTAL_RAG_API_KEY blank to reuse the active chat key; an explicit RAG
# key overrides it. Copy the two full endpoint URLs from your Bailian workspace
# and region console. Destinations are never guessed from the chat URL.
RENTAL_RAG_API_KEY=
RENTAL_RAG_EMBEDDING_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
RENTAL_RAG_RERANK_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RENTAL_RAG_EMBEDDING_MODEL=text-embedding-v4
RENTAL_RAG_RERANK_MODEL=qwen3-rerank
RENTAL_RAG_DIMENSIONS=1024
# After configuration: .venv/bin/python scripts/rag_index.py --embed
# Restart scripts/dev.py to load the new settings into the running API.
