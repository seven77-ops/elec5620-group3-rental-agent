{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Self-contained local contract; format validation must be enabled. Business cross-field rules remain in Python.",
  "title": "RentalProfile",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "search_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "currency": {
          "const": "AUD"
        },
        "period": {
          "const": "week"
        },
        "scope": {
          "enum": [
            "per_person",
            "per_room",
            "whole_property"
          ]
        },
        "includes_bills": {
          "type": "boolean"
        },
        "preferred": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "hard_limit": {
          "type": "boolean"
        }
      },
      "required": [
        "currency",
        "period",
        "scope",
        "includes_bills",
        "preferred",
        "maximum",
        "hard_limit"
      ],
      "additionalProperties": false
    },
    "occupants": {
      "type": "integer",
      "minimum": 1
    },
    "rental_mode": {
      "enum": [
        "whole_property",
        "private_room",
        "shared_room",
        "student_accommodation"
      ]
    },
    "destination_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "arrival_time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "const": "Australia/Sydney"
    },
    "commute": {
      "type": "object",
      "properties": {
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "public_transport",
              "walk",
              "drive",
              "bike"
            ]
          },
          "minItems": 1
        },
        "preferred_minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "maximum_minutes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "hard_limit": {
          "type": "boolean"
        }
      },
      "required": [
        "modes",
        "preferred_minutes",
        "maximum_minutes",
        "hard_limit"
      ],
      "additionalProperties": false
    },
    "move_in_window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "lease_months": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "hard_requirements": {
      "type": "array",
      "items": {
        "enum": [
          "private_bedroom",
          "private_bathroom",
          "furnished",
          "laundry",
          "kitchen_access"
        ]
      }
    },
    "soft_preferences": {
      "type": "object",
      "properties": {
        "private_bedroom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "private_bathroom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "furnished": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "laundry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "kitchen_access": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "weights": {
      "type": "object",
      "properties": {
        "commute": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "housing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "amenities": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "commute",
        "cost",
        "housing",
        "amenities"
      ],
      "additionalProperties": false
    },
    "housing_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suburb": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "min_bedrooms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "min_bathrooms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "min_car_spaces": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "budget_match_mode": {
          "enum": [
            "advertised_amount",
            "matching_scope"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "search_id",
    "profile_version",
    "budget",
    "occupants",
    "rental_mode",
    "destination_id",
    "arrival_time",
    "timezone",
    "commute",
    "move_in_window",
    "lease_months",
    "hard_requirements",
    "soft_preferences",
    "weights"
  ],
  "additionalProperties": false
}
