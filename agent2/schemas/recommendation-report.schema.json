{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Self-contained local contract; format validation must be enabled. Business cross-field rules remain in Python.",
  "title": "RecommendationReport",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "scoring_version": {
      "const": "rules-1.0"
    },
    "search_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "data_mode": {
      "const": "synthetic_demo"
    },
    "recommendation_run_id": {
      "type": "string",
      "pattern": "^rr-[0-9a-f]{64}$"
    },
    "profile_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "profile": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "search_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "type": "object",
          "properties": {
            "currency": {
              "const": "AUD"
            },
            "period": {
              "const": "week"
            },
            "scope": {
              "enum": [
                "per_person",
                "per_room",
                "whole_property"
              ]
            },
            "includes_bills": {
              "type": "boolean"
            },
            "preferred": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "maximum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "hard_limit": {
              "type": "boolean"
            }
          },
          "required": [
            "currency",
            "period",
            "scope",
            "includes_bills",
            "preferred",
            "maximum",
            "hard_limit"
          ],
          "additionalProperties": false
        },
        "occupants": {
          "type": "integer",
          "minimum": 1
        },
        "rental_mode": {
          "enum": [
            "whole_property",
            "private_room",
            "shared_room",
            "student_accommodation"
          ]
        },
        "destination_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "arrival_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timezone": {
          "const": "Australia/Sydney"
        },
        "commute": {
          "type": "object",
          "properties": {
            "modes": {
              "type": "array",
              "items": {
                "enum": [
                  "public_transport",
                  "walk",
                  "drive",
                  "bike"
                ]
              },
              "minItems": 1
            },
            "preferred_minutes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "maximum_minutes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "hard_limit": {
              "type": "boolean"
            }
          },
          "required": [
            "modes",
            "preferred_minutes",
            "maximum_minutes",
            "hard_limit"
          ],
          "additionalProperties": false
        },
        "move_in_window": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "lease_months": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000000000000
        },
        "hard_requirements": {
          "type": "array",
          "items": {
            "enum": [
              "private_bedroom",
              "private_bathroom",
              "furnished",
              "laundry",
              "kitchen_access"
            ]
          }
        },
        "soft_preferences": {
          "type": "object",
          "properties": {
            "private_bedroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "private_bathroom": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "furnished": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "laundry": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "kitchen_access": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "weights": {
          "type": "object",
          "properties": {
            "commute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "housing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "amenities": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "search_id",
        "profile_version",
        "budget",
        "occupants",
        "rental_mode",
        "destination_id",
        "arrival_time",
        "timezone",
        "commute",
        "move_in_window",
        "lease_months",
        "hard_requirements",
        "soft_preferences",
        "weights"
      ],
      "additionalProperties": false
    },
    "effective_weights": {
      "type": "object",
      "properties": {
        "commute": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "housing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "amenities": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "required": [
        "commute",
        "cost",
        "housing",
        "amenities"
      ],
      "additionalProperties": false
    },
    "report_status": {
      "enum": [
        "partial",
        "complete"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "eligible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "excluded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "input",
        "eligible",
        "pending",
        "excluded",
        "duplicates"
      ],
      "additionalProperties": false
    },
    "recommendations": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/evaluation"
          },
          {
            "properties": {
              "status": {
                "const": "eligible"
              }
            }
          }
        ]
      },
      "maxItems": 5
    },
    "eligible": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/evaluation"
          },
          {
            "properties": {
              "status": {
                "const": "eligible"
              }
            }
          }
        ]
      },
      "maxItems": 30
    },
    "pending_confirmation": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/evaluation"
          },
          {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          }
        ]
      },
      "maxItems": 30
    },
    "excluded": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/evaluation"
          },
          {
            "properties": {
              "status": {
                "const": "excluded"
              }
            }
          }
        ]
      },
      "maxItems": 30
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "listing_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "listing_id",
          "duplicate_of",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "clarification_requests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "data_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "comparison": {
      "type": "object",
      "properties": {
        "before_profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "after_profile_version": {
          "type": "integer",
          "minimum": 1
        },
        "before_weights": {
          "type": "object",
          "properties": {
            "commute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "housing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "amenities": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        },
        "after_weights": {
          "type": "object",
          "properties": {
            "commute": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "housing": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "amenities": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        },
        "before_run_id": {
          "type": "string",
          "pattern": "^rr-[0-9a-f]{64}$"
        },
        "after_run_id": {
          "type": "string",
          "pattern": "^rr-[0-9a-f]{64}$"
        },
        "changed_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "before": {},
              "after": {}
            },
            "required": [
              "field",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "listing_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "before_status": {
                "enum": [
                  "eligible",
                  "pending",
                  "excluded",
                  "duplicate"
                ]
              },
              "after_status": {
                "enum": [
                  "eligible",
                  "pending",
                  "excluded",
                  "duplicate"
                ]
              },
              "before_rank": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_rank": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rank_change": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "before_score": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_score": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "score_change": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "change_reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "score_contributions": {
                "type": "object",
                "properties": {
                  "commute": {
                    "type": "object",
                    "properties": {
                      "before": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "after": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "change": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "before",
                      "after",
                      "change"
                    ],
                    "additionalProperties": false
                  },
                  "cost": {
                    "type": "object",
                    "properties": {
                      "before": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "after": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "change": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "before",
                      "after",
                      "change"
                    ],
                    "additionalProperties": false
                  },
                  "housing": {
                    "type": "object",
                    "properties": {
                      "before": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "after": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "change": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "before",
                      "after",
                      "change"
                    ],
                    "additionalProperties": false
                  },
                  "amenities": {
                    "type": "object",
                    "properties": {
                      "before": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "after": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      },
                      "change": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": -100,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "before",
                      "after",
                      "change"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "commute",
                  "cost",
                  "housing",
                  "amenities"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "listing_id",
              "before_status",
              "after_status",
              "before_rank",
              "after_rank",
              "rank_change",
              "before_score",
              "after_score",
              "score_change"
            ],
            "additionalProperties": false
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "before_profile_version",
        "after_profile_version",
        "before_weights",
        "after_weights",
        "before_run_id",
        "after_run_id",
        "changed_fields",
        "rows",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scoring_version",
    "search_id",
    "profile_version",
    "data_mode",
    "recommendation_run_id",
    "profile_fingerprint",
    "dataset_fingerprint",
    "as_of",
    "profile",
    "effective_weights",
    "report_status",
    "counts",
    "recommendations",
    "eligible",
    "pending_confirmation",
    "excluded",
    "duplicates",
    "clarification_requests",
    "data_limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "data_kind": {
          "const": "synthetic"
        }
      },
      "required": [
        "source_ref",
        "observed_at",
        "data_kind"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "listing_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "eligible",
            "pending",
            "excluded"
          ]
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "score_range": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "score_breakdown": {
          "type": "object",
          "properties": {
            "commute": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "cost": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "housing": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "amenities": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "commute",
            "cost",
            "housing",
            "amenities"
          ],
          "additionalProperties": false
        },
        "evidence_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hard_checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "status",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "weekly_cost": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "commute_minutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "walking_minutes": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "transfers": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "supermarket_distance_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "evidence_refs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence"
          }
        },
        "last_checked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "listing_id",
        "status",
        "rank",
        "score",
        "score_range",
        "score_breakdown",
        "evidence_coverage",
        "hard_checks",
        "weekly_cost",
        "commute_minutes",
